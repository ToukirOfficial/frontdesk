# Copy to deploy.env (gitignored) and fill in. Server details never go in the repository.
# An SSH host or alias from your ~/.ssh/config (keys only).
REMOTE=my-server
# Where releases live on the server.
APP_DIR=/path/to/app
# The public hostname, used for the health check.
DOMAIN=frontdesk.example.com
# The API's address on the server. Next.js bakes its /api rewrite in at build time.
API_URL=http://127.0.0.1:API_PORT
# Optional: when REMOTE logs in as root, run every server step as this user.
DEPLOY_AS=
