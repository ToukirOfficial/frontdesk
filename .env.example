# Copy to .env and fill in. Never commit .env or put live keys in this file.
NODE_ENV=development

# Where people reach Frontdesk (the dashboard, the demo and /widget.js). Locally: http://localhost:8025
WEB_URL=http://localhost:8025
API_PORT=8125
API_URL=http://127.0.0.1:8125

DATABASE_URL=postgresql://frontdesk:frontdesk@localhost:5432/frontdesk
TEST_DATABASE_URL=postgresql://frontdesk:frontdesk@localhost:5432/frontdesk_test
# Redis database 7; every key and queue starts with REDIS_PREFIX.
REDIS_URL=redis://127.0.0.1:6379/7
REDIS_PREFIX=frontdesk

# Random secrets. Generate each with: openssl rand -hex 32
JWT_SECRET=
CODE_SECRET=
# AES-256-GCM key for stored API keys (Slotwise): exactly 64 hex characters.
ENCRYPTION_KEY=

# Email (login codes, invites, enquiries). Leave SMTP_URL empty locally: emails go to apps/api/tmp/mail/*.eml.
# Required in production unless DEMO_MODE=true. Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Frontdesk <no-reply@frontdesk.example>"

# AI provider: bring your own key. All optional. Leave AI_PROVIDER empty and the app still starts and works:
# each workspace then adds its own key in the dashboard (AI provider), and until one does, the chat says
# "No AI provider configured". Set these only to give every workspace this server's key.
# AI_PROVIDER: anthropic, openai, gemini or openai-compatible (any OpenAI-style endpoint, e.g. Ollama).
# AI_MODEL: the model id exactly as your provider writes it. There is no default.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# openai-compatible only, e.g. Ollama on this machine: http://localhost:11434/v1 (AI_API_KEY can stay empty)
AI_BASE_URL=
# Anthropic with the key above only: low, medium or high. Empty = the model's default.
ANTHROPIC_EFFORT=

# Embeddings: local (free, runs on your server, ~100 MB model downloaded on first use) or openai.
# Changing this later means processing your knowledge again.
EMBEDDING_PROVIDER=local
# Only for EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
MODEL_CACHE_DIR=./storage/models
# Uploaded knowledge files and avatars (outside any public folder).
STORAGE_DIR=./storage

# Public demo: seeded fictional clinic, sign-up off, strict limits, no real emails, nightly reset. Costs the host
# nothing: visitors get recorded sample answers (apps/api/demo/replay.json) or paste their own key. The demo never
# uses AI_API_KEY. The cap below only limits visitors' own keys.
DEMO_MODE=false
DEMO_MONTHLY_TOKEN_CAP=300000

# Who may set X-Forwarded-For: loopback (a proxy on this machine) or private (also private networks, e.g. docker).
TRUST_PROXY=loopback
# Development only: lets website import and Slotwise reach localhost (e.g. a local Slotwise). Refused in production.
ALLOW_PRIVATE_URLS=false
