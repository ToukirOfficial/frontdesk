# Copy to .env and fill in the secrets. Never put live keys in this file.
NODE_ENV=development

# Local ports
WEB_URL=http://localhost:8025
API_PORT=8125
API_URL=http://127.0.0.1:8125

DATABASE_URL=postgresql://frontdesk:frontdesk@localhost:5432/frontdesk
TEST_DATABASE_URL=postgresql://frontdesk:frontdesk@localhost:5432/frontdesk_test
# Redis database 7; every key and queue starts with REDIS_PREFIX.
REDIS_URL=redis://127.0.0.1:6379/7
REDIS_PREFIX=frontdesk

# Random secrets. Generate each with: openssl rand -hex 32
JWT_SECRET=
CODE_SECRET=
# AES-256-GCM key for stored API keys (Slotwise): exactly 64 hex characters.
ENCRYPTION_KEY=

# Leave SMTP_URL empty locally: emails are written to tmp/mail/*.eml instead of being sent.
SMTP_URL=
MAIL_FROM="Frontdesk <no-reply@frontdesk.example>"

# Public demo: seeded fictional clinic, strict limits, no real emails, nightly reset.
DEMO_MODE=false
