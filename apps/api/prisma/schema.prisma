generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Conventions: UUIDv7 ids, createdAt/updatedAt on every table, instants as timestamptz (UTC),
// snake_case table names. Every workspace-owned row carries workspaceId and every query filters by it.

enum Role {
  owner
  admin
  staff
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  loginCodes    LoginCode[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]

  @@map("users")
}

/// A 6-digit code emailed after a correct password. Stored as an HMAC, single use, limited attempts.
model LoginCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("login_codes")
}

/// Rotating refresh token. Stored as SHA-256 of its secret. All rotations of one login share familyId;
/// presenting an already-rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @map("token_hash")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  invites     Invite[]
  business    BusinessProfile?
  assistant   AssistantSettings?
  sources     KnowledgeSource[]
  chunks      KnowledgeChunk[]

  @@map("workspaces")
}

model Membership {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        Role
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invite {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  email       String
  role        Role
  tokenHash   String    @unique @map("token_hash")
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("invites")
}

enum Preset {
  general
  law
  clinic
}

enum SourceType {
  faq
  text
  file
  url
}

enum SourceStatus {
  processing
  ready
  failed
}

/// Structured business details. Always given to the assistant, as reference data.
model BusinessProfile {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String   @unique @map("workspace_id") @db.Uuid
  name         String   @default("")
  address      String   @default("")
  /// { mon: { closed, open, close }, … , notes }
  openingHours Json     @map("opening_hours")
  email        String   @default("")
  phone        String   @default("")
  bookingUrl   String   @default("") @map("booking_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model AssistantSettings {
  id                String   @id @default(uuid(7)) @db.Uuid
  workspaceId       String   @unique @map("workspace_id") @db.Uuid
  preset            Preset   @default(general)
  rules             String   @default("")
  slotwiseBaseUrl   String?  @map("slotwise_base_url")
  /// AES-256-GCM sealed API key. Never returned by the API.
  slotwiseKeyCipher String?  @map("slotwise_key_cipher")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("assistant_settings")
}

model KnowledgeSource {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  type        SourceType
  title       String
  /// FAQ question (type faq)
  question    String?
  /// Plain text (text) or FAQ answer (faq)
  content     String?
  /// Stored file name inside STORAGE_DIR (file); never a user-supplied path
  storedName  String?      @map("stored_name")
  mimeType    String?      @map("mime_type")
  sizeBytes   Int?         @map("size_bytes")
  /// Start URL (url)
  url         String?
  /// Page limit for a website import (url)
  maxPages    Int?         @map("max_pages")
  status      SourceStatus @default(processing)
  error       String?
  chunkCount  Int          @default(0) @map("chunk_count")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]

  @@index([workspaceId, createdAt])
  @@map("knowledge_sources")
}

/// One embedded piece of knowledge. workspaceId is copied here so every vector search filters on it directly.
model KnowledgeChunk {
  id          String                       @id @default(uuid(7)) @db.Uuid
  workspaceId String                       @map("workspace_id") @db.Uuid
  sourceId    String                       @map("source_id") @db.Uuid
  position    Int
  content     String
  /// Page URL for imported websites
  pageUrl     String?                      @map("page_url")
  embedding   Unsupported("vector(384)")
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId])
  @@map("knowledge_chunks")
}
